    "test": "vitest run"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.11",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "lucide-react": "^1.61.0",
    "marked": "^18.1.1",
    "next": "16.4.2",
    "postgres": "^3.4.9",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^22.20.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "prettier": "^3.9.10",
    "tailwindcss": "^4",
    "typescript": "^5",
    "typescript-eslint": "^8.72.0",
    "vitest": "^5.0.5"
  },
  "allowScripts": {
    "unrs-resolver": false
  },
  "engines": {
    "node": ">=22.12"
  }
