{
  "name": "flow-e-web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "sync": "node scripts/sync-docs.mjs && npm --prefix .. run build",
    "predev": "npm run sync",
    "dev": "next dev",
    "prebuild": "npm run sync",
    "build": "next build",
    "start": "next start",
    "prelint": "npm run sync",
    "lint": "eslint .",
